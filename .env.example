# MongoDB Atlas connection string. Never commit a real credential.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_AUTH_DB=fl_cockpit_auth
MONGODB_APP_DB=fl_cockpit_app
MONGODB_MAX_POOL_SIZE=20
MONGODB_MAX_IDLE_TIME_MS=5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=10000
HEALTH_CHECK_TIMEOUT_MS=8000
# CLI release checks can load another file, e.g. `.env.preproduction`.
DEPLOYMENT_ENV_FILE=.env.local
# Optional immutable URL checked by `npm run verify:deployment`.
DEPLOYMENT_URL=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
AUTH_ALLOW_SIGN_UP=false

# Invitations. Keep `manual` locally; use `resend` in preproduction/production.
INVITATION_EMAIL_PROVIDER=manual
RESEND_API_KEY=
INVITATION_EMAIL_FROM=F&L Cockpit <invitations@example.com>
INVITATION_EMAIL_REPLY_TO=
INVITATION_EMAIL_TIMEOUT_MS=10000

# Upload boundary, in bytes (10 MB by default).
IMPORT_MAX_BYTES=10000000

# Lecture hors connexion : âge maximal 1–24 h, purge 1–48 h (>= âge), catalogue 1–2000.
# L’expiration de session peut raccourcir la consultation. Purge au prochain accès local.
OFFLINE_MAX_AGE_HOURS=12
OFFLINE_RETENTION_HOURS=24
OFFLINE_MAX_PRODUCTS=2000

# Copilote analytique (Responses API). La clé reste exclusivement côté serveur.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_OUTPUT_TOKENS=2400 # includes visible output and reasoning tokens
OPENAI_MAX_TOOL_ROUNDS=4 # max model rounds that may call tools (8 calls total)
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=30000

# Optional overrides for `npm run seed:demo`.
SEED_DEMO_EMAIL=admin@fleg.local
SEED_DEMO_PASSWORD=FlegDemo!2026
SEED_DEMO_USER_NAME=Administrateur F&L
SEED_DEMO_MANAGER_EMAIL=manager@fleg.local
SEED_DEMO_MANAGER_PASSWORD=FlegManager!2026
SEED_DEMO_MANAGER_NAME=Manager F&L
SEED_DEMO_ORGANIZATION_NAME=Réseau F&L Démo
SEED_DEMO_ORGANIZATION_SLUG=reseau-fl-demo
SEED_DEMO_STORE_CODE=DEMO-01
SEED_DEMO_STORE_NAME=Magasin F&L Démo
SEED_DEMO_CONTROL_STORE_CODE=DEMO-02
SEED_DEMO_CONTROL_STORE_NAME=Magasin F&L Témoin
